{
  "name": "pora",
  "version": "1.27.0",
  "description": "«Пора» — личный планировщик: задачи, календарь, привычки, фокус-таймер и синхронизация через свой сервер.",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test '{src,server,scripts}/**/*.test.{ts,mjs}'",
    "lint": "eslint . && node scripts/check-raw-colors.mjs && node scripts/contrast.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.0",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.0.0",
    "heic-convert": "^2.1.0",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.56.1"
  }
}
