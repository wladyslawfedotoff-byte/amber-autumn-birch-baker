# =====================================================================
#  «Пора» — секреты для Docker Compose (шаблон).
#
#  Скопируйте этот файл в .env рядом с compose.yaml:
#    /volume1/docker/pora/.env
#  и впишите свои значения. compose.yaml подключает его через
#    env_file:
#      - .env
#  Файл .env ОБЯЗАТЕЛЕН — без него проект не запустится.
#
#  .env НИКОГДА не попадает в GitHub и в Docker-образ (.gitignore,
#  .dockerignore). В git лежит только этот шаблон без настоящих значений.
#
#  Права: читать .env должен только администратор. В File Station:
#  .env → Свойства → Разрешения — оставьте доступ только своей учётной
#  записи администратора (или группе administrators), уберите Everyone
#  и users. По SSH дополнительно: sudo chmod 600 /volume1/docker/pora/.env
#  Container Manager работает от root и прочитает файл в любом случае.
#
#  Несекретные настройки (APP_URL, DATA_DIR, VITE_GROK_EXTENSIONS=0,
#  порт) задаются в compose.yaml, здесь их повторять не нужно.
# =====================================================================
#
#  ПРАВИЛА ЗАПИСИ ЗНАЧЕНИЙ (проверено на Docker Compose v2.20 — версия
#  в Container Manager DSM 7.2 — и на актуальной Compose v5):
#
#  * Одна строка — одна переменная: ИМЯ=значение (лучше без пробелов).
#    Строки, начинающиеся с #, — комментарии.
#  * Символ $ в значении БЕЗ кавычек или в "двойных кавычках" Compose
#    считает подстановкой переменной: APP_PASSWORD=ab$cd превратится в «ab»
#    (и в журнале будет предупреждение «The "cd" variable is not set»).
#  * Чтобы $ остался буквально, заключите значение в 'одинарные кавычки':
#      APP_PASSWORD='ab$cd'      → ab$cd
#    или удвойте его без кавычек:
#      APP_PASSWORD=ab$$cd       → ab$cd
#    Обратная косая черта \$ НЕ экранирует.
#  * « #» (пробел + решётка) в значении без кавычек начинает комментарий:
#    APP_PASSWORD=abc #xyz → «abc». Внутри кавычек # — обычный символ.
#  * Пробелы в начале и в конце значения отбрасываются.
#  * Одинарную кавычку внутри '…' в Compose v2.20 записать нельзя.
#  * Пробелы ВНУТРИ значения сохраняются (и без кавычек, и в '…').
#  Проще всего — фраза из нескольких слов через дефис или пробел, без
#  символов $ ' " \ #, либо APP_PASSWORD_HASH (в хэше только
#  A–Z a–z 0–9 : _ -, кавычки не нужны).
# =====================================================================


# --- Вход в приложение (обязательно одно из двух) ---------------------

# Пароль для входа. Рекомендуется ФРАЗА из 4–5 случайных слов, 16+ символов
# (пример формата: «слово-слово-слово-слово», придумайте свою).
# Минимум 12 символов; при длине 12–15 приложение работает, но пишет в
# журнал предупреждение auth.weak_password. Пока здесь заглушка
# СМЕНИТЕ_МЕНЯ (или пароль короче 12 символов), приложение показывает только
# страницу «Вход не настроен» и больше ничего не отдаёт.
# Защита от подбора: 5 неудачных попыток с одного IP за 15 минут, а после
# 50 неудачных попыток со всех адресов вход новых устройств закрывается на
# 15 минут (уже вошедшие устройства продолжают работать).
APP_PASSWORD=СМЕНИТЕ_МЕНЯ

# Рекомендуется вместо APP_PASSWORD: scrypt-хэш пароля. Если задан, он
# имеет приоритет, а APP_PASSWORD можно удалить — тогда открытого пароля
# нет ни в файле, ни в настройках контейнера (их видно в Container Manager
# и в `docker inspect`). Получить хэш (скрипт спросит пароль дважды, ввод
# скрыт):
#   на NAS по SSH, без клона репозитория:
#     sudo docker run --rm -it --entrypoint node ghcr.io/wladyslawfedotoff-byte/amber-autumn-birch-baker:latest scripts/hash-password.mjs
#   или в уже запущенном контейнере:
#     sudo docker exec -it pora-app node scripts/hash-password.mjs
#   или на компьютере с Node 22 в клоне репозитория:
#     node scripts/hash-password.mjs
# Вставьте выведенную строку целиком, формат: scrypt:32768:8:1:<соль>:<хэш>
# APP_PASSWORD_HASH=


# --- Необязательные секреты -------------------------------------------

# Ключ подписи сессий, не короче 32 символов. Если не задан, приложение
# само создаёт случайный ключ в data/.session-secret (права 0600) — этого
# достаточно. Сгенерировать: openssl rand -hex 32
# Смена ключа (или пароля) разлогинивает все устройства. Без смены ключа
# то же делает кнопка «Выйти на всех устройствах» в Настройках.
# SESSION_SECRET=

# Ключ xAI API для раздела «Помощник» (разбор текста на задачи и план на
# день). Без ключа пункта «Помощник» в меню нет, остальное работает.
# С ключом тексты задач для помощника отправляются в api.x.ai.
# XAI_API_KEY=


# --- Необязательные настройки (не секреты) ----------------------------

# Владелец папки data, если контейнер не может в неё писать
# (id пользователя / группы DSM, узнать по SSH: id <пользователь>).
# По умолчанию — встроенный пользователь node (1000:1000).
# PUID=1026
# PGID=100

# Резервные копии data/pora.json в data/backups (делаются перед
# сохранением изменений, не чаще раза в BACKUP_INTERVAL_MINUTES минут).
# Хранятся: самая свежая копия каждого из последних BACKUP_HOURLY часов и
# каждого из последних BACKUP_DAILY дней (дни по UTC). Самая новая копия
# не удаляется никогда. Список и восстановление — docs/SYNOLOGY.md, раздел
# «Резервные копии».
# BACKUP_INTERVAL_MINUTES=30
# BACKUP_HOURLY=24
# BACKUP_DAILY=30
