# Copy to .env on the NAS (never commit .env). No secrets in the git repo.

# Public HTTPS origin served by DSM Reverse Proxy (4th-level DDNS subdomain).
# Example: https://pora.example.synology.me
APP_URL=https://pora.example.synology.me
BETTER_AUTH_URL=https://pora.example.synology.me

# Node / Nitro listen port inside the container (compose maps 127.0.0.1:$PORT).
PORT=8080

# --- Database (optional for current «Пора») ---
# Tasks are stored in the browser (localStorage). Leave DATABASE_URL empty
# unless you enable auth / add migrations that need Postgres.
# When using the optional compose db service:
# DATABASE_URL=postgresql://pora:CHANGE_ME@db:5432/pora
DATABASE_URL=

# Postgres service credentials (only if you uncomment db in docker-compose.yml)
POSTGRES_USER=pora
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=pora

# --- Auth (optional; .grok/app-env.json has VITE_AUTH_ENABLED=false) ---
# Generate e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Optional AI assistant (server-side; leave empty to disable) ---
XAI_API_KEY=
