# =====================================================================
#  «Пора» — секреты для Docker Compose (шаблон).
#
#  Скопируйте этот файл в .env рядом с compose.yaml:
#    /volume1/docker/pora/.env
#  и впишите свои значения. compose.yaml подключает его через
#    env_file:
#      - .env
#  Файл .env ОБЯЗАТЕЛЕН — без него проект не запустится.
#
#  .env НИКОГДА не попадает в GitHub и в Docker-образ (.gitignore,
#  .dockerignore). В git лежит только этот шаблон без настоящих значений.
#
#  Права: читать .env должен только администратор. В File Station:
#  .env → Свойства → Разрешения — оставьте доступ только своей учётной
#  записи администратора (или группе administrators), уберите Everyone
#  и users. По SSH дополнительно: sudo chmod 600 /volume1/docker/pora/.env
#  Container Manager работает от root и прочитает файл в любом случае.
#
#  Несекретные настройки (APP_URL, DATA_DIR, VITE_GROK_EXTENSIONS=0,
#  порт) задаются в compose.yaml, здесь их повторять не нужно.
# =====================================================================
#
#  ПРАВИЛА ЗАПИСИ ЗНАЧЕНИЙ (проверено на Docker Compose v2.20 — версия
#  в Container Manager DSM 7.2 — и на актуальной Compose v5):
#
#  * Одна строка — одна переменная: ИМЯ=значение (лучше без пробелов).
#    Строки, начинающиеся с #, — комментарии.
#  * Символ $ в значении БЕЗ кавычек или в "двойных кавычках" Compose
#    считает подстановкой переменной: APP_PASSWORD=ab$cd превратится в «ab»
#    (и в журнале будет предупреждение «The "cd" variable is not set»).
#  * Чтобы $ остался буквально, заключите значение в 'одинарные кавычки':
#      APP_PASSWORD='ab$cd'      → ab$cd
#    или удвойте его без кавычек:
#      APP_PASSWORD=ab$$cd       → ab$cd
#    Обратная косая черта \$ НЕ экранирует.
#  * « #» (пробел + решётка) в значении без кавычек начинает комментарий:
#    APP_PASSWORD=abc #xyz → «abc». Внутри кавычек # — обычный символ.
#  * Пробелы в начале и в конце значения отбрасываются.
#  * Одинарную кавычку внутри '…' в Compose v2.20 записать нельзя.
#  * Пробелы ВНУТРИ значения сохраняются (и без кавычек, и в '…').
#  Проще всего — фраза из нескольких слов через дефис или пробел, без
#  символов $ ' " \ #, либо APP_PASSWORD_HASH (в хэше только
#  A–Z a–z 0–9 : _ -, кавычки не нужны).
# =====================================================================


# --- Вход в приложение (обязательно одно из двух) ---------------------
# (для нескольких профилей см. блок «Несколько профилей» ниже)

# Пароль для входа. Рекомендуется ФРАЗА из 4–5 случайных слов, 16+ символов
# (пример формата: «слово-слово-слово-слово», придумайте свою).
# Минимум 12 символов; при длине 12–15 приложение работает, но пишет в
# журнал предупреждение auth.weak_password. Пока здесь заглушка
# СМЕНИТЕ_МЕНЯ (или пароль короче 12 символов), приложение показывает только
# страницу «Вход не настроен» и больше ничего не отдаёт.
# Защита от подбора: 5 неудачных попыток с одного IP за 15 минут, а после
# 50 неудачных попыток со всех адресов вход новых устройств закрывается на
# 15 минут (уже вошедшие устройства продолжают работать).
APP_PASSWORD=СМЕНИТЕ_МЕНЯ

# Рекомендуется вместо APP_PASSWORD: scrypt-хэш пароля. Если задан, он
# имеет приоритет, а APP_PASSWORD можно удалить — тогда открытого пароля
# нет ни в файле, ни в настройках контейнера (их видно в Container Manager
# и в `docker inspect`). Получить хэш (скрипт спросит пароль дважды, ввод
# скрыт):
#   на NAS по SSH, без клона репозитория:
#     sudo docker run --rm -it --entrypoint node ghcr.io/wladyslawfedotoff-byte/amber-autumn-birch-baker:latest scripts/hash-password.mjs
#   или в уже запущенном контейнере:
#     sudo docker exec -it pora-app node scripts/hash-password.mjs
#   или на компьютере с Node 22 в клоне репозитория:
#     node scripts/hash-password.mjs
# Вставьте выведенную строку целиком, формат: scrypt:32768:8:1:<соль>:<хэш>
# APP_PASSWORD_HASH=


# --- Несколько профилей (необязательно) -------------------------------
#
# По умолчанию «Пора» — один профиль с паролем APP_PASSWORD(_HASH) выше
# (логин admin, поле «Логин» на странице входа не показывается).
# Чтобы у каждого были свой логин, пароль и свои задачи, перечислите
# логины в APP_USERS (латиница a–z, цифры, _ и -, до 32 символов) и задайте
# каждому пароль. Имя переменной: USER_ + логин ЗАГЛАВНЫМИ (- → _) + суффикс.
# Хэш для конкретного логина печатает готовой строкой:
#   sudo docker exec -it pora-app node scripts/hash-password.mjs user2
#
#
# Профилей может быть сколько угодно, например APP_USERS=user1,user2,user3;
# для каждого логина — свои строки USER_<ЛОГИН>_NAME и USER_<ЛОГИН>_PASSWORD
# (или USER_<ЛОГИН>_PASSWORD_HASH). Логин — любое слово из a-z, 0-9, _ и -.
# APP_USERS=user1,user2
# USER_USER1_NAME=Пользователь 1
# USER_USER1_PASSWORD_HASH=scrypt:32768:8:1:<соль>:<хэш>
# USER_USER2_NAME=Пользователь 2
# USER_USER2_PASSWORD_HASH=scrypt:32768:8:1:<соль>:<хэш>
# (вместо _HASH можно USER_USER2_PASSWORD=<фраза 16+ символов>)
#
# Переход с одного профиля: всё, что уже есть в data/pora.json, получает
# APP_OWNER (по умолчанию первый логин в APP_USERS). Ему можно не задавать
# USER_<ЛОГИН>_PASSWORD(_HASH) — подойдёт прежний APP_PASSWORD(_HASH).
# APP_OWNER=user1
#
# Логин единственного профиля, если APP_USERS не задан (по умолчанию admin).
# APP_DEFAULT_USER=admin
#
# Пароль, сменённый в приложении («Настройки → Профиль»), хранится в
# data/users.json и важнее значения здесь. Сбросить на пароль из .env:
#   sudo docker exec pora-app node scripts/reset-password.mjs <логин>


# --- Необязательные секреты -------------------------------------------

# Ключ подписи сессий, не короче 32 символов. Если не задан, приложение
# само создаёт случайный ключ в data/.session-secret (права 0600) — этого
# достаточно. Сгенерировать: openssl rand -hex 32
# Смена ключа (или пароля) разлогинивает все устройства. Без смены ключа
# то же делает кнопка «Выйти на всех устройствах» в Настройках.
# SESSION_SECRET=

# --- «Помощник» (необязательно) -----------------------------------------
# Без этих строк пункта «Помощник» нет, остальное работает как обычно.
# Ключи читает только сервер: в приложение, в репозиторий и в образ они не
# попадают; в «Настройках → Помощник» видны лишь адрес и модель.
#
# Помощник читает только задачи, списки и привычки вошедшего пользователя
# (и то, чем с ним поделились) и ничего не меняет без «Применить».
# ВАЖНО: при облачной модели текст вопроса и нужные для ответа задачи
# уходят в облачный сервис. Только домашний ПК — данные не покидают сеть.
#
# Модели спрашиваются по очереди (AI_PROVIDERS): домашний ПК, если включён,
# потом бесплатные облачные, последней — платная. Ошибка, лимит (429),
# тайм-аут или исчерпанная квота → следующая модель / следующий сервис;
# неудачный пропускается на AI_COOLDOWN_SEC (по умолчанию 300 = 5 минут).
# Если не ответил никто, в чате есть «Повторить» и «Отложить» (сервер сам
# переспрашивает до суток; ответ придёт в беседу и в колокольчик).
#
# AI_PROVIDERS=local,openrouter,kieai
#
# local — модель на ПК в домашней сети (docs/SYNOLOGY.md, раздел 10). Ключ
# не нужен. На ПК работает Ollama или LM Studio:
#   AI_LOCAL_URL   адрес ПК с портом (с /v1 на конце или без — всё равно)
#   AI_LOCAL_TYPE  ollama | lmstudio | auto (по умолчанию auto: сервер сам
#                  проверит /api/tags, затем /v1/models)
#   AI_LOCAL_MODEL модель; пусто — Ollama берёт qwen2.5:7b-instruct,
#                  LM Studio — загруженную в нём модель
# Для видеокарты 8 ГБ подойдёт Qwen2.5 7B Instruct (умеет вызывать функции).
#
# Вариант 1: Ollama (порт 11434)
# AI_LOCAL_TYPE=ollama
# AI_LOCAL_URL=http://192.168.1.50:11434
# AI_LOCAL_MODEL=qwen2.5:7b-instruct
#
# Вариант 2: LM Studio (порт 1234; имя модели — как в LM Studio,
# список: http://<IP ПК>:1234/v1/models)
# AI_LOCAL_TYPE=lmstudio
# AI_LOCAL_URL=http://192.168.1.50:1234/v1
# AI_LOCAL_MODEL=qwen2.5-7b-instruct
#
# Старые имена AI_OLLAMA_URL / AI_OLLAMA_MODEL по-прежнему работают
# (означают AI_LOCAL_TYPE=ollama).
#
# Любое другое имя — OpenAI-совместимый сервис. Переменные AI_<ИМЯ>_…:
#   BASE_URL  адрес API (обычно оканчивается на /v1); если у сервиса свой
#             адрес на каждую модель, впишите {model} — подставится MODEL
#   API_KEY   ключ (передаётся как Authorization: Bearer)
#   MODEL     модель или несколько через запятую (пробуются по порядку)
#   PAID=1    платный: пользователь может выключить «Разрешить платные»
#   MONTHLY_TOKENS  потолок токенов в месяц (0/пусто — без потолка)
#   CHECK_URL адрес для «Проверить связь» (по умолчанию BASE_URL/models)
#   JSON_FORMAT=0  не просить у модели response_format (если сервис его
#             не принимает; ответ в JSON помощник всё равно разберёт)
#   TOOLS     как модель читает задачи и предлагает изменения:
#             auto (по умолчанию) — вызов функций, а если сервис их отвергает
#             или молча игнорирует («нет доступа к инструментам») — JSON;
#             json — сразу JSON (инструменты описаны в запросе, карточки
#             подтверждения работают так же); native — только вызов функций.
#             Для ПК — AI_LOCAL_TOOLS.
#   MAX_TOKENS  потолок длины одного ответа модели (по умолчанию AI_MAX_TOKENS,
#             то есть 600; 0 — не ограничивать). Если сервис параметр не
#             принимает, помощник повторит запрос без него.
#   REASONING_EFFORT  minimal|low|medium|high — сколько модель «думает»
#             перед ответом (размышления тоже оплачиваются как токены).
#             Не задано — решает сервис.
#
# Пример: бесплатные модели (у них суффикс :free; список меняется —
# проверьте актуальный на сайте сервиса). Многие бесплатные модели не умеют
# вызывать функции — помощник сам переходит на ответ в формате JSON.
# AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_OPENROUTER_API_KEY=впишите-свой-ключ
# AI_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free
#
# Пример: kie.ai — платный, последний запасной вариант. Оплата кредитами
# за токены (цены — на странице модели на kie.ai). OpenAI-совместимый чат
# у kie.ai есть у части моделей, и у каждой свой адрес
# https://api.kie.ai/<модель>/v1/chat/completions — отсюда {model}.
# Названия моделей (с суффиксом -openai) и цены проверьте на kie.ai перед
# включением: список меняется. Ошибки kie.ai присылает с кодом 200 и полем
# "code" в ответе — помощник это понимает (402 нет кредитов, 429 лимит →
# следующая модель). CHECK_URL показывает, принимается ли ключ (баланс).
# AI_KIEAI_BASE_URL=https://api.kie.ai/{model}/v1
# AI_KIEAI_API_KEY=впишите-свой-ключ
# AI_KIEAI_MODEL=gemini-3-8-flash-openai
# AI_KIEAI_PAID=1
# AI_KIEAI_MONTHLY_TOKENS=2000000
# AI_KIEAI_CHECK_URL=https://api.kie.ai/api/v1/chat/credit
# AI_KIEAI_JSON_FORMAT=0
# AI_KIEAI_TOOLS=json
# AI_KIEAI_REASONING_EFFORT=low
# У kie.ai вызов функций у чат-моделей ограничен (например, gpt-5-2
# принимает только встроенный веб-поиск), поэтому TOOLS=json: помощник
# описывает свои инструменты в запросе и получает ответ в JSON.
# REASONING_EFFORT=low заметно снижает расход у gpt-5-2 (по умолчанию у него
# high, а размышления оплачиваются как выходные токены).
#
# Простые варианты без цепочки (если AI_PROVIDERS не задан):
#   только ПК:      AI_LOCAL_URL (+ AI_LOCAL_TYPE, AI_LOCAL_MODEL)
#   только облако:  AI_BASE_URL, AI_API_KEY, AI_MODEL
#   оба:            ПК, а когда он выключен — облако (AI_PREFER=cloud — наоборот)
#   AI_PROVIDER=off выключает помощника, не стирая остальные строки.
#   Старый XAI_API_KEY по-прежнему работает (облачная модель как в 1.5).
#
# Тонкая настройка:
# AI_TIMEOUT_SEC=90     ожидание одного ответа модели
# AI_RATE_LIMIT=60      вопросов в час на пользователя (0 — без ограничения)
# AI_COOLDOWN_SEC=300   пауза для модели после ошибки или лимита
# AI_TOOLS=json         JSON-режим для всех моделей сразу (вместо AI_<ИМЯ>_TOOLS)
# AI_MAX_TOKENS=600     потолок длины ответа для всех моделей (0 — без потолка)
# AI_LOCAL_ANSWERS=0    не отвечать самому на простые вопросы («что просрочено»,
#                       «что на сегодня», «свободные окна завтра») — по умолчанию
#                       приложение отвечает на них без модели и токенов
# AI_DEBUG_STREAM=1     записать в журнал первые строки потока от модели
#                       (assistant.stream_debug) — для разбора сбоев; потом выключить


# --- Напоминания на телефоне (необязательно) -------------------------
# Без этих строк уведомления выключены, остальное работает как обычно.
# Пара ключей создаётся ОДИН раз (смена ключей выключит уведомления на всех
# устройствах — их придётся включить заново). На NAS по SSH:
#   sudo docker exec pora-app node scripts/push-keys.mjs
# или без запущенного контейнера:
#   sudo docker run --rm --entrypoint node ghcr.io/wladyslawfedotoff-byte/amber-autumn-birch-baker:latest scripts/push-keys.mjs
# Скрипт печатает две строки — вставьте их сюда вместо заглушек.
# PUSH_CONTACT — ваш адрес для связи службы уведомлений с владельцем сервера.
# PUSH_VAPID_PUBLIC_KEY=ВСТАВЬТЕ_ОТКРЫТЫЙ_КЛЮЧ
# PUSH_VAPID_PRIVATE_KEY=ВСТАВЬТЕ_ЗАКРЫТЫЙ_КЛЮЧ
# PUSH_CONTACT=mailto:you@example.org

# Часовой пояс напоминаний, если устройство его не сообщило
# (по умолчанию Europe/Moscow).
# APP_TIMEZONE=Europe/Moscow


# --- Необязательные настройки (не секреты) ----------------------------

# Владелец папки data, если контейнер не может в неё писать
# (id пользователя / группы DSM, узнать по SSH: id <пользователь>).
# По умолчанию — встроенный пользователь node (1000:1000).
# PUID=1026
# PGID=100

# Резервные копии data/pora.json в data/backups (делаются перед
# сохранением изменений, не чаще раза в BACKUP_INTERVAL_MINUTES минут).
# Хранятся: самая свежая копия каждого из последних BACKUP_HOURLY часов и
# каждого из последних BACKUP_DAILY дней (дни по UTC). Самая новая копия
# не удаляется никогда. Список и восстановление — docs/SYNOLOGY.md, раздел
# «Резервные копии».
# BACKUP_INTERVAL_MINUTES=30
# BACKUP_HOURLY=24
# BACKUP_DAILY=30


# --- Вложения: фото, PDF, сканы (1.9.0, необязательно) ----------------
# Файлы хранятся в ./data/attachments на NAS. Предел размера одного файла
# в мегабайтах (по умолчанию 25, максимум 200).
# ATTACH_MAX_MB=25
