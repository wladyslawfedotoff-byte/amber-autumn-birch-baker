# Copy to .env next to docker-compose*.yml on the NAS (never commit .env).
# No real secrets belong in git or in the Docker image — only here / in
# Container Manager → Проект → environment.

# Public HTTPS origin of the DSM Reverse Proxy, WITH the port.
APP_URL=https://pora.fedotovvladislav.synology.me:8443

# --- Login (one password for the whole app) ---
# Min 8 characters. The app shows «Вход не настроен» until this is changed.
# If the password contains "$", prefer APP_PASSWORD_HASH.
APP_PASSWORD=СМЕНИТЕ_МЕНЯ
# Alternative (wins over APP_PASSWORD): output of
#   node scripts/hash-password.mjs
# Format: scrypt:N:r:p:salt:hash
APP_PASSWORD_HASH=

# Optional (>= 32 chars, e.g. `openssl rand -base64 48`). If empty, a random
# secret is generated once into $DATA_DIR/.session-secret (mode 0600).
# Changing it (or the password) logs out every device.
SESSION_SECRET=

# --- Storage ---
# Inside the container; compose mounts ./data:/data.
DATA_DIR=/data
# Rotating copies of pora.json in $DATA_DIR/backups.
BACKUP_INTERVAL_MINUTES=30
BACKUP_KEEP=10

# Optional: run as the owner of ./data when the folder is not writable
# (DSM user id / group id, e.g. 1026 / 100). Empty = built-in user "node".
PUID=
PGID=

# Grok in-app extensions are off for the self-hosted build.
VITE_GROK_EXTENSIONS=0

# Development only — ignored when NODE_ENV=production (the Docker image).
# AUTH_DISABLED=true

# --- Optional, not used by «Пора» today ---
DATABASE_URL=
XAI_API_KEY=
